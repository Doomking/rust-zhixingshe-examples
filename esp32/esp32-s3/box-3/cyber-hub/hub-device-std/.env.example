# ESP32-S3 Voice Interaction Configuration
# Rename this file to .env and put your real credentials here

WIFI_SSID="your_wifi_ssid"
WIFI_PASS="your_wifi_password"

# The IP of the backend server (e.g. your Mac or Hub Server)
SERVER_IP="192.168.1.100"
WEATHER_CITY=your city

# --- 本地预制语音（构建时生成 assets/wake.pcm、done.pcm，需本机有 say + ffmpeg）---
# CYBER_HUB_VOICE_WAKE="我在"
# CYBER_HUB_VOICE_DONE="好了"
# CI 或无 say 环境可设为 1，并保留已生成的 .pcm 文件
# CYBER_HUB_VOICE_SKIP_BUILD=0

# 启动后约 1s 播放一次 wake 提示（验证本地播放链路；默认不写或 0 则不播）
# CYBER_HUB_BOOT_VOICE=1
