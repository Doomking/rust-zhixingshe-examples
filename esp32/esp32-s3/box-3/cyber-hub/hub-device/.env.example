# CyberHub ESP32-S3 Environment Configuration 
# Please duplicate this file, rename it to .env, and fill in your actual credentials.
# Note: The .env file is intentionally ignored by git to protect your secrets.

# Your local Wi-Fi Name (SSID)
WIFI_SSID="your_ssid_here"

# Your local Wi-Fi Password
WIFI_PASS="your_password_here"

# The local IPv4 address of the Mac running the TCP server (mac_server.py)
MAC_IP="192.168.1.100"
