# 调试 ZeroClaw 请求/响应 JSON（可选）:
# RUST_LOG=hub_server::ai=debug,hub_server::zeroclaw=debug,info

# TCP 网关（BOX-3 连接 SERVER_IP:SERVER_PORT）
SERVER_PORT=8080

# ZeroClaw — ws_chat（默认，带工具）/ webhook（无工具）/ openai（需 Gateway 挂载 /v1）
ZEROCLAW_MODE=ws_chat
ZEROCLAW_WS_CHAT_URL=ws://127.0.0.1:42617/ws/chat
# 多轮会话记忆：固定 session_id；设为空字符串则每次新 UUID
ZEROCLAW_WS_SESSION_ID=cyber-hub
# ZEROCLAW_WS_SESSION_NAME=BOX-3
#
# ZEROCLAW_MODE=webhook  # 仅简单对话，无工具
ZEROCLAW_WEBHOOK_URL=http://127.0.0.1:42617/webhook
# ZEROCLAW_WEBHOOK_SECRET=
#
# ZEROCLAW_MODE=openai
ZEROCLAW_URL=http://127.0.0.1:42617/v1
# Gateway 开启 pairing 时：填 POST /pair 返回的 Bearer（见 daemon 启动说明）
ZEROCLAW_API_KEY=zeroclaw

# 把 ZeroClaw 文本回复转为语音，下发给设备（macOS: say + ffmpeg）
ENABLE_TTS_FEEDBACK=true
TTS_VOICE=Tingting
TTS_RATE=180
TTS_MAX_CHARS=180

# 对外 STT（当 USE_INTERNAL_STT=false 时用 Whisper API；也可配 Ollama 等）
AI_BASE_URL=http://localhost:11434/v1
AI_API_KEY=ollama
AI_MODEL=llama3

# true：本地 whisper-rs + STT_MODEL_PATH；false：走 AI_BASE_URL 转写
USE_INTERNAL_STT=true
STT_MODEL_PATH=models/ggml-medium.bin

# 会话原始 PCM 落盘（调试用）
AUDIO_STORAGE_PATH=/tmp

# AudioProcessor VAD 阈值（能量域，与设备端无关）
VAD_THRESHOLD=2500.0
